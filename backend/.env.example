# PowerShell: establece las variables con $env:VARIABLE='valor'. No se carga .env automáticamente.
DJANGO_SECRET_KEY=swipehome-local-development-only
# Establecer a 1 en desarrollo local: activa DEBUG. NO usar en producción.
DJANGO_DEV=1

# --- Despliegue (Render) ---
# Dominios permitidos adicionales, separados por comas. En Render no hace
# falta: el dominio publico se anade solo via RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=

# --- Firebase ---
# Se usa la primera que esté definida, en este orden.
#
# 1) Render: contenido COMPLETO del JSON de la cuenta de servicio, en una sola
#    linea. Es una credencial de administrador: solo se configura en Render,
#    nunca en el repositorio ni en el chat del equipo.
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2) Local: ruta al fichero JSON de la cuenta de servicio, guardado FUERA del
#    repositorio. Pídelo a Arnau.
GOOGLE_APPLICATION_CREDENTIALS=

# ID del proyecto de Firebase (no es secreto).
FIREBASE_PROJECT_ID=swipehome-a51d7
