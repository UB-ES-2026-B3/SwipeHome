# PowerShell: establece las variables con $env:VARIABLE='valor'. No se carga .env automáticamente.
DJANGO_SECRET_KEY=swipehome-local-development-only
# Ruta opcional; por defecto backend/db.sqlite3
DATABASE_PATH=db.sqlite3
# Establecer a 1 para desarrollo HTTP local (runserver).
# Deshabilita Secure en cookies de sesión y CSRF, y activa DEBUG.
# NO usar en producción ni con runhttps.
DJANGO_DEV=1
