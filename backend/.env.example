# PowerShell: establece las variables con $env:VARIABLE='valor'. No se carga .env automáticamente.
DJANGO_SECRET_KEY=swipehome-local-development-only
# Ruta opcional; por defecto backend/db.sqlite3
DATABASE_PATH=db.sqlite3
# Establecer a 1 para desarrollo HTTP local (runserver).
# Deshabilita Secure en cookies de sesión y CSRF, y activa DEBUG.
# NO usar en producción ni con runhttps.
DJANGO_DEV=1

# --- Despliegue (Render) ---
# Dominios permitidos adicionales, separados por comas. En Render no hace
# falta: el dominio publico se anade solo via RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=

# --- Firebase (pendiente de la migracion de auth) ---
# Contenido COMPLETO del JSON de la cuenta de servicio, en una sola linea.
# Es una credencial de administrador: solo se configura en Render,
# nunca en el repositorio ni en el chat del equipo.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ID del proyecto de Firebase (no es secreto).
FIREBASE_PROJECT_ID=swipehome-a51d7
