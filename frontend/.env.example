# Copia este fichero a .env.local (ignorado por Git) y rellena los valores.
# Están en la consola de Firebase → Configuración del proyecto → General → Tus apps.
# No son secretos: viajan en el bundle de JavaScript. Van por variable de entorno
# para no tocar código si algún día cambia el proyecto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=swipehome-a51d7
VITE_FIREBASE_APP_ID=
# Opcional: limita Auth al emulador local, por ejemplo 127.0.0.1:9099.
VITE_FIREBASE_AUTH_EMULATOR_HOST=

# URL del backend cuando está en otro dominio (Azure Static Web Apps → Azure
# Container Apps), sin /api: p. ej. https://<app>.<región>.azurecontainerapps.io
# Vacía = rutas relativas /api/..., que necesitan el proxy de Vite en local y
# el rewrite de Render. Se fija al compilar (npm run build).
VITE_API_BASE_URL=
