# Copia este fichero a .env.local (ignorado por Git) y rellena los valores.
# Están en la consola de Firebase → Configuración del proyecto → General → Tus apps.
# No son secretos: viajan en el bundle de JavaScript. Van por variable de entorno
# para no tocar código si algún día cambia el proyecto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=swipehome-a51d7
VITE_FIREBASE_APP_ID=
